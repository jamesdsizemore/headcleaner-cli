{
  "name": "headcleaner",
  "displayName": "HeadCleaner",
  "description": "Browse and lint headcleaner OKF bundles in VS Code.",
  "version": "0.7.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onLanguage:markdown",
    "workspaceContains:**/manifest.json",
    "workspaceContains:**/bundle.manifest.json",
    "onView:headcleaner.concepts",
    "onView:headcleaner.trust"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "headcleaner.lintBundle",
        "title": "HeadCleaner: Lint OKF Bundle",
        "category": "HeadCleaner"
      },
      {
        "command": "headcleaner.attest",
        "title": "HeadCleaner: Attest Bundle",
        "category": "HeadCleaner"
      },
      {
        "command": "headcleaner.verify",
        "title": "HeadCleaner: Verify Bundle",
        "category": "HeadCleaner"
      },
      {
        "command": "headcleaner.refreshBundle",
        "title": "HeadCleaner: Refresh Bundle",
        "category": "HeadCleaner"
      },
      {
        "command": "headcleaner.openConcept",
        "title": "HeadCleaner: Open Concept",
        "category": "HeadCleaner"
      }
    ],
    "views": {
      "headcleaner-explorer": [
        {
          "id": "headcleaner.concepts",
          "name": "Concept Explorer",
          "when": "workspaceFolderCount > 0"
        },
        {
          "id": "headcleaner.trust",
          "name": "Trust Inspector",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "headcleaner-explorer",
          "title": "HeadCleaner",
          "icon": "resources/headcleaner.svg"
        }
      ]
    },
    "configuration": {
      "title": "HeadCleaner",
      "properties": {
        "headcleaner.pythonPath": {
          "type": "string",
          "default": "headcleaner",
          "description": "Path to the headcleaner executable on the system PATH."
        },
        "headcleaner.theme": {
          "type": "string",
          "enum": ["neon", "light", "dark", "mono"],
          "default": "neon",
          "description": "Color theme for the side panel."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -watch",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
